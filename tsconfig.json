{
  "compilerOptions": {
    // other options...
    "types": [
      "jest",
      "react-native"
    ],
    "target": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-native",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": "./",
    "paths": {
      "@assets/*": [
        "assets/*"
      ],
      "@screens/*": [
        "screens/*"
      ],
      "@navigators/*": [
        "navigators/*"
      ]
    }
  },
  "include": [
    "src",
    "App.tsx",
    "__tests__"
  ],
  "exclude": [
    "node_modules"
  ],
  "extends": "@react-native/typescript-config/tsconfig.json"
}
